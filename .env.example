# Local development uses real Bedrock responses. Copy to ignored .env; never commit credentials.
ENVIRONMENT=local
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_PROFILE=research-operator
AWS_REGION=us-east-1
DATABASE_URL=sqlite:///./local-data/research.db
STORAGE_BACKEND=local
STORAGE_PATH=local-data/uploads
EMBEDDING_PROVIDER=fake
BOOTSTRAP_OWNER_EMAIL=demo@example.test
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Fake mode is for explicit offline tests only; it returns synthetic reports.
# MODEL_PROVIDER=fake
# TAVILY_API_KEY=free-plan-key
# LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=project-public-key
# LANGFUSE_SECRET_KEY=project-secret-key
