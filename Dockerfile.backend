FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY backend ./backend
ARG INSTALL_EXTRAS=""
# Complete a cross-platform dependency lock before promoting this image to AWS.
RUN if [ -n "$INSTALL_EXTRAS" ]; then pip install --no-cache-dir ".[${INSTALL_EXTRAS}]"; else pip install --no-cache-dir .; fi
RUN useradd --uid 10001 --create-home research && mkdir -p /app/local-data && chown -R research:research /app/local-data
USER research
EXPOSE 8000
CMD ["uvicorn", "research_app.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM runtime AS embeddings
USER root
ARG EMBEDDING_REVISION
RUN test -n "$EMBEDDING_REVISION" && pip install --no-cache-dir 'sentence-transformers==5.7.0' && python -c "from sentence_transformers import SentenceTransformer; import os,re; revision=os.environ['EMBEDDING_REVISION']; assert re.fullmatch('[a-f0-9]{40}',revision); SentenceTransformer('BAAI/bge-small-en-v1.5', revision=revision, cache_folder='/opt/models')"
ENV SENTENCE_TRANSFORMERS_HOME=/opt/models HF_HUB_OFFLINE=1
USER research
