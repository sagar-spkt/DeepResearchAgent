# Copy into a private ignored local environment file; never use these outside local.
LOCAL_DB_PASSWORD=replace-with-random-local-password
# Containerized local API/worker use real Bedrock responses; Compose pins the provider.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
LOCAL_LANGFUSE_ENCRYPTION_KEY=replace-with-64-random-hex-characters
LOCAL_LANGFUSE_AUTH_SECRET=generated-by-setup-script
LOCAL_LANGFUSE_SALT=generated-by-setup-script
LOCAL_CLICKHOUSE_PASSWORD=generated-by-setup-script
LOCAL_VALKEY_PASSWORD=generated-by-setup-script
LOCAL_SEAWEEDFS_ACCESS_KEY=generated-by-setup-script
LOCAL_SEAWEEDFS_SECRET_KEY=generated-by-setup-script
LANGFUSE_INIT_ORG_ID=deepresearch-local
LANGFUSE_INIT_ORG_NAME=DeepResearchLocal
LANGFUSE_INIT_PROJECT_ID=research-agent-local
LANGFUSE_INIT_PROJECT_NAME=ResearchAgentLocal
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=generated-by-setup-script
LANGFUSE_INIT_PROJECT_SECRET_KEY=generated-by-setup-script
LANGFUSE_INIT_USER_EMAIL=demo@example.test
LANGFUSE_INIT_USER_NAME=LocalResearchOwner
LANGFUSE_INIT_USER_PASSWORD=generated-by-setup-script
LOCAL_LANGFUSE_CONTAINER_BASE_URL=
# Start Postgres: docker compose --env-file .env.platform up -d postgres
# Run scripts/setup_local_langfuse.py before enabling the observability profile.
