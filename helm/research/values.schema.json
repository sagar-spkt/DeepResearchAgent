{
  "type": "object",
  "required": [
    "environment",
    "backendImage",
    "webImage"
  ],
  "properties": {
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "backendImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "webImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "properties": {
        "bedrockModelId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
