# Local mode is rejected when APP_ENV is not local.
APP_ENV=local
AUTH_MODE=local
DEV_USER=demo@example.test
API_INTERNAL_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
# For AWS set APP_ENV=staging or production and AUTH_MODE=cognito.
# Public Cognito app client: authorization code flow, PKCE, no client secret.
# Register https://your-host/auth/callback as callback and enable openid email profile.
# COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# COGNITO_CLIENT_ID=
# AUTH_SESSION_SECRET=generate-at-least-32-random-characters-outside-source-control
