#!/bin/bash
set -Eeuo pipefail
set +x
export AWS_DEFAULT_REGION=us-east-1
bootstrap_complete=false
bootstrap_step=initialize

set_bootstrap_step() {
  bootstrap_step="$1"
  printf '[runner-bootstrap] %s\n' "$bootstrap_step" >/dev/console 2>/dev/null || true
}

terminate_self() {
  local token instance_id
  token=$(curl --fail --silent --show-error --request PUT --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token) || { shutdown -h now || true; return; }
  instance_id=$(curl --fail --silent --show-error --header "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id) || { shutdown -h now || true; return; }
  aws ec2 terminate-instances --instance-ids "$instance_id" >/dev/null 2>&1 || shutdown -h now || true
}
on_exit() {
  local status=$?
  trap - EXIT
  if [[ "$bootstrap_complete" != true ]]; then
    printf '[runner-bootstrap] failed at %s with exit %s\n' "$bootstrap_step" "$status" >/dev/console 2>/dev/null || true
    rm -f /run/actions-runner/token /opt/actions-runner/configure-once.sh || true
    local token instance_id safe_step
    token=$(curl --fail --silent --show-error --request PUT --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token) || token=
    if [[ -n "$token" ]]; then
      instance_id=$(curl --fail --silent --show-error --header "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id) || instance_id=
      if [[ -n "$instance_id" ]]; then
        safe_step=$(printf '%s' "$bootstrap_step" | tr ' ' '-')
        tag_value="failed-$safe_step-$status"
        aws ec2 create-tags --resources "$instance_id" --tags "Key=BootstrapStatus,Value=$tag_value" >/dev/null 2>&1 || true
      fi
    fi
    terminate_self
  fi
  exit "$status"
}
trap on_exit EXIT

# Install the deadline and the runner-user-callable completion hook before bootstrap can fail.
set_bootstrap_step "install 85 minute watchdog"
cat >/usr/local/sbin/actions-runner-terminate <<'HOOK'
#!/bin/bash
set -eu
export AWS_DEFAULT_REGION=us-east-1
token=$(curl --fail --silent --show-error --request PUT --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token) || { shutdown -h now; exit 1; }
instance_id=$(curl --fail --silent --show-error --header "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id) || { shutdown -h now; exit 1; }
aws ec2 terminate-instances --instance-ids "$instance_id" >/dev/null || shutdown -h now
HOOK
chmod 755 /usr/local/sbin/actions-runner-terminate
cat >/etc/systemd/system/actions-runner-watchdog.service <<'UNIT'
[Unit]
Description=Terminate staging runner if setup or job hangs
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/actions-runner-terminate
UNIT
cat >/etc/systemd/system/actions-runner-watchdog.timer <<'UNIT'
[Unit]
Description=Hard lifetime bound for ephemeral staging runner
[Timer]
OnActiveSec=85min
Unit=actions-runner-watchdog.service
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now actions-runner-watchdog.timer

if command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  set_bootstrap_step "rewrite Ubuntu package sources to HTTPS"
  sed -i -E '/^URIs:/s#http://#https://#g' /etc/apt/sources.list.d/ubuntu.sources
  if grep -Eq '^URIs: http://' /etc/apt/sources.list.d/ubuntu.sources; then
    echo "Ubuntu package sources must use HTTPS from the private runner subnet." >&2
    exit 1
  fi
  set_bootstrap_step "update Ubuntu package indexes"
  apt-get -o Acquire::Retries=3 update
  set_bootstrap_step "install Docker and AWS CLI verification tools"
  apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates curl docker.io docker-buildx git gnupg python3 tar unzip
  aws_cli_version=2.40.3
  set_bootstrap_step "verify and install pinned AWS CLI $aws_cli_version"
  installer_dir=$(mktemp -d /run/aws-cli-install.XXXXXX)
  chmod 700 "$installer_dir"
  install -d -m 700 "$installer_dir/gnupg"
  cat >"$installer_dir/aws-cli-team.asc" <<'AWSCLIKEY'
-----BEGIN PGP PUBLIC KEY BLOCK-----

mQINBF2Cr7UBEADJZHcgusOJl7ENSyumXh85z0TRV0xJorM2B/JL0kHOyigQluUG
ZMLhENaG0bYatdrKP+3H91lvK050pXwnO/R7fB/FSTouki4ciIx5OuLlnJZIxSzx
PqGl0mkxImLNbGWoi6Lto0LYxqHN2iQtzlwTVmq9733zd3XfcXrZ3+LblHAgEt5G
TfNxEKJ8soPLyWmwDH6HWCnjZ/aIQRBTIQ05uVeEoYxSh6wOai7ss/KveoSNBbYz
gbdzoqI2Y8cgH2nbfgp3DSasaLZEdCSsIsK1u05CinE7k2qZ7KgKAUIcT/cR/grk
C6VwsnDU0OUCideXcQ8WeHutqvgZH1JgKDbznoIzeQHJD238GEu+eKhRHcz8/jeG
94zkcgJOz3KbZGYMiTh277Fvj9zzvZsbMBCedV1BTg3TqgvdX4bdkhf5cH+7NtWO
lrFj6UwAsGukBTAOxC0l/dnSmZhJ7Z1KmEWilro/gOrjtOxqRQutlIqG22TaqoPG
fYVN+en3Zwbt97kcgZDwqbuykNt64oZWc4XKCa3mprEGC3IbJTBFqglXmZ7l9ywG
EEUJYOlb2XrSuPWml39beWdKM8kzr1OjnlOm6+lpTRCBfo0wa9F8YZRhHPAkwKkX
XDeOGpWRj4ohOx0d2GWkyV5xyN14p2tQOCdOODmz80yUTgRpPVQUtOEhXQARAQAB
tCFBV1MgQ0xJIFRlYW0gPGF3cy1jbGlAYW1hem9uLmNvbT6JAlQEEwEIAD4CGwMF
CwkIBwIGFQoJCAsCBBYCAwECHgECF4AWIQT7Xbd/1cEYuAURraimMQrMRnJHXAUC
akV0ygUJDqP4lQAKCRCmMQrMRnJHXFHjD/9eyZLYcKuQOlLvtqSDtUBiEZf6ZZjM
i3ygYH8rJNtuToUH+HvSpe819urJCquXhDrlK6N+aqW0hCLtNABJG/vsafIgvIYJ
hSGgpgtNnQyMV1jViRWqPjbouw8OkYKBThUfT1i2Y+wn58ifs6ODBCmTexWtXspA
Si+Gt49xDOW0APmbOPnI+a4HJW6tVEo6MWS0WjzpiBayR3d1A4pt4YrPfSdDgpLo
h2SLQqlRqvvVZJaWBjhkErNFpfsBA06sDcPEOb0G8LBUbR4WOcdvhe5LubJbZuxC
AG9kNPCVeQP1ixwjgjXKysaxeQ6rv0VzIQgRp6tLVLWhy6AKDNvLjFSsmXZ1Wl08
Y/RlOHXlzLuQMRE6sR1wOdRxc9TsrNWTGiBK65cvSWOy03JeBkQQ8pesqltiyxI9
U21kkgiXtTSKNGfKK8pO27D81YANhRqPK7iTp6kuFiY2WtOg90KTMNlIT+Ff85Y2
b1rHj6Z0SrCkJujhWk3IBPic/wJgz01LEc/OAdUPlby90RJZcIBhSlWhT7mXnXIO
c0HWlNQrns2s3CTyYwZSiSlYe9ApeLwhjDo8NhbFuCAy61l6O5UsR4AfZxx/rGKv
2wFb1/RN/P4gNe6vmxZAPjR0AQcwD3tc2McimOLr/22kmPz8IH3I0X7WoSFr0Biz
E91G7bb0hOb/cA==
=knv7
-----END PGP PUBLIC KEY BLOCK-----
AWSCLIKEY
  chmod 600 "$installer_dir/aws-cli-team.asc"
  GNUPGHOME="$installer_dir/gnupg" gpg --batch --import "$installer_dir/aws-cli-team.asc" >/dev/null 2>&1
  key_fingerprint=$(GNUPGHOME="$installer_dir/gnupg" gpg --batch --with-colons --fingerprint A6310ACC4672475C | awk -F: '$1 == "fpr" {print $10; exit}')
  if [[ "$key_fingerprint" != "FB5DB77FD5C118B80511ADA8A6310ACC4672475C" ]]; then
    echo "AWS CLI signing key fingerprint did not match the pinned AWS key." >&2
    exit 1
  fi
  curl --fail --silent --show-error --location https://awscli.amazonaws.com/v2/install.sh -o "$installer_dir/install.sh"
  curl --fail --silent --show-error --location https://awscli.amazonaws.com/v2/install.sh.sig -o "$installer_dir/install.sh.sig"
  GNUPGHOME="$installer_dir/gnupg" gpg --batch --verify "$installer_dir/install.sh.sig" "$installer_dir/install.sh"
  bash "$installer_dir/install.sh" --system --version "$aws_cli_version"
  rm -rf "$installer_dir"
  systemctl enable --now docker
  getent group docker >/dev/null || groupadd docker
  id runner >/dev/null 2>&1 || useradd --create-home --shell /bin/bash runner
  usermod -aG docker runner
else
  echo "Runner base image must use Ubuntu with apt-get." >&2
  exit 1
fi

for command in curl sha256sum tar aws systemctl gpg; do command -v "$command" >/dev/null; done
for command in docker git python3; do command -v "$command" >/dev/null; done
id runner >/dev/null 2>&1
runner_group=$(id -gn runner)
id -nG runner | tr ' ' '\n' | grep -Fx docker >/dev/null
docker buildx version >/dev/null
docker_ready=false
set_bootstrap_step "wait for Docker and Buildx"
for attempt in {1..30}; do
  if su - runner -c 'docker info >/dev/null 2>&1 && docker buildx version >/dev/null 2>&1'; then
    docker_ready=true
    break
  fi
  sleep 2
done
if [[ "$docker_ready" != true ]]; then exit 1; fi
install -d -o runner -g "$runner_group" /opt/actions-runner /run/actions-runner
set_bootstrap_step "download and verify GitHub Actions runner"
archive=/run/actions-runner/runner.tar.gz
token_file=/run/actions-runner/token
chmod 700 /run/actions-runner
curl --fail --silent --show-error --location "https://github.com/actions/runner/releases/download/v${version}/actions-runner-linux-x64-${version}.tar.gz" -o "$archive"
printf '%s  %s\n' '${sha256}' "$archive" | sha256sum --check --status
tar -xzf "$archive" -C /opt/actions-runner
chown -R runner:"$runner_group" /opt/actions-runner
rm -f "$archive"

# IAM/profile changes can take time to propagate after RunInstances. Keep the token
# response out of logs and only configure the runner after both one-time operations work.
retrieved=false
set_bootstrap_step "retrieve one-time registration token"
for attempt in {1..12}; do
  if aws --cli-connect-timeout 5 --cli-read-timeout 10 ssm get-parameter --name '${parameter_name}' --with-decryption --query Parameter.Value --output text >"$token_file" 2>/dev/null; then
    retrieved=true
    break
  fi
  sleep 5
done
if [[ "$retrieved" != true ]]; then exit 1; fi
chmod 600 "$token_file"
deleted=false
for attempt in {1..12}; do
  if aws --cli-connect-timeout 5 --cli-read-timeout 10 ssm delete-parameter --name '${parameter_name}' >/dev/null 2>&1; then
    deleted=true
    break
  fi
  sleep 5
done
if [[ "$deleted" != true ]]; then exit 1; fi
if [[ ! -s "$token_file" || "$(cat "$token_file")" == "None" ]]; then exit 1; fi
chown runner:"$runner_group" "$token_file"
chmod 600 "$token_file"
chown root:docker /run/actions-runner
chmod 710 /run/actions-runner
set_bootstrap_step "configure ephemeral GitHub runner"
cat >/opt/actions-runner/configure-once.sh <<'CONFIG'
#!/bin/bash
set -Eeuo pipefail
set +x
cd /opt/actions-runner
token=$(cat /run/actions-runner/token)
./config.sh --unattended --disableupdate --ephemeral --url 'https://github.com/${repository}' --token "$token" --labels 'self-hosted,linux,staging-vpc' --name 'staging-${session_id}'
unset token
rm -f /run/actions-runner/token
CONFIG
chown root:docker /opt/actions-runner/configure-once.sh
chmod 750 /opt/actions-runner/configure-once.sh
su - runner -c /opt/actions-runner/configure-once.sh
rm -f /opt/actions-runner/configure-once.sh /run/actions-runner/token
cat >/etc/systemd/system/actions-runner.service <<'UNIT'
[Unit]
Description=One-job GitHub Actions staging runner
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=runner
WorkingDirectory=/opt/actions-runner
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/usr/local/sbin/actions-runner-terminate
Environment=AWS_DEFAULT_REGION=us-east-1
ExecStart=/opt/actions-runner/run.sh
Restart=no
UNIT
systemctl daemon-reload
set_bootstrap_step "start ephemeral GitHub runner service"
systemctl enable --now actions-runner.service
bootstrap_complete=true
